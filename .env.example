PORT=3000

# Database Configuration
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# AI Assistant (Gemini)
# Obtené una clave gratis en https://aistudio.google.com/apikey
# Varias claves separadas por coma (una por cuenta): se rotan automáticamente
# cuando una se queda sin cuota, subiendo el límite diario de consultas.
AI_API_KEYS=
# Compatible con configuraciones anteriores: si se define, se usa como clave adicional.
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
# Cadena de modelos en orden de preferencia (opcional). Si queda vacía se usa
# AI_MODEL y ante saturación (503) se cae a gemini-3.5-flash y gemini-3.5-flash-lite.
AI_MODELS=
# true: los datos de clientes (razón social, CUIT) se anonimizan antes de enviarse al modelo.
# La respuesta se des-anonimiza automáticamente solo para mostrarse en el chat.
AI_ANONYMIZE=true
